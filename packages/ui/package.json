{
  "name": "@stackvibe-studio/ui",
  "version": "0.3.1",
  "type": "module",
  "description": "Core React component library for StackVibe UI.",
  "repository": {
    "type": "git",
    "url": "https://github.com/StackVibe-Studio/stackvibe-ui.git"
  },
  "homepage": "https://stackvibe-studio.github.io/stackvibe-ui/",
  "bugs": {
    "url": "https://github.com/StackVibe-Studio/stackvibe-ui/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "react-19",
    "ui",
    "ui-components",
    "design-system",
    "stackvibe",
    "tailwind",
    "tailwindcss",
    "dialog",
    "drawer",
    "modal",
    "toast",
    "dropdown-menu",
    "accordion",
    "tooltip",
    "switch",
    "progress",
    "button",
    "input",
    "card",
    "badge",
    "avatar",
    "tabs",
    "skeleton",
    "select",
    "accessible",
    "wai-aria",
    "nextjs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc --project tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.7.0"
  }
}
